# ============================================================
# SmartHirePro - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# Choose: "openai" or "ollama"
LLM_PROVIDER=openai

# ── OpenAI (if LLM_PROVIDER=openai) ─────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (if LLM_PROVIDER=ollama) ─────────────────────────
# Ensure Ollama is running: ollama serve
# Pull a model first: ollama pull llama3
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM Generation Settings ─────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ── Embedding Settings ───────────────────────────────────────
# Recommended: all-MiniLM-L6-v2 (fast) or all-mpnet-base-v2 (accurate)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Vector Store ─────────────────────────────────────────────
# Choose: "faiss" or "chroma"
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=data/vector_store/faiss_index
CHROMA_PERSIST_DIR=data/vector_store/chroma
CHROMA_COLLECTION_NAME=resumes

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────────────────────
TOP_K_CHUNKS=10
TOP_K_RESUMES=5

# ── Data Paths ───────────────────────────────────────────────
RAW_RESUME_DIR=data/raw_resumes
PROCESSED_RESUME_DIR=data/processed_resumes_en
HF_DATASET_NAME=d4rk3r/resumes-raw-pdf

# ── HuggingFace ──────────────────────────────────────────────
HUGGINGFACE_TOKEN=your-hf-token-here

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/smarthirepro.log
